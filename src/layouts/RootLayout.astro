---
/* src/layouts/RootLayout.astro */
import "../shared/styles/global.css";
import Navbar from "@/shared/components/Navbar.astro";

interface Props {
  title?: string;
}
const { title = "Ancient Nature" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&family=Work+Sans:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen relative text-foreground selection:bg-foreground selection:text-background">
    
    <div class="fixed inset-0 -z-10 overflow-hidden bg-background transition-colors duration-500">
      
      <div class="absolute inset-0 
        bg-[linear-gradient(to_right,rgba(0,0,0,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.05)_1px,transparent_1px)] 
        dark:bg-[linear-gradient(to_right,rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.05)_1px,transparent_1px)] 
        bg-[size:24px_24px] 
        transition-all duration-500">
      </div>
      
      <div class="absolute -top-[10%] -left-[10%] h-[50vw] w-[50vw] rounded-full bg-foreground opacity-[0.08] dark:opacity-[0.04] blur-[100px] transition-opacity duration-500"></div>
      <div class="absolute top-[40%] right-[10%] h-[30vw] w-[30vw] rounded-full bg-foreground opacity-[0.08] dark:opacity-[0.04] blur-[80px] transition-opacity duration-500"></div>
    </div>

    <Navbar />
    <main class="relative z-10">
      <slot />
    </main>
  </body>
</html>