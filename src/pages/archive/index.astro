---
/* src/pages/archive/index.astro */
import RootLayout from "@/layouts/RootLayout.astro";
import ArchiveExplorer from "@/shared/components/archive/ArchiveExplorer";
import { getCollection } from "astro:content";


const allMobs = await getCollection("archive");


const formattedData = allMobs.map((mob) => ({
  id: mob.id,
  name: mob.data.name,
  era: mob.data.era,
  period: mob.data.period,
  category: mob.data.category,
  tags: mob.data.tags,
  stats: mob.data.stats,
  information: mob.data.information,
  guide: mob.data.guide,
  dimorphism: mob.data.dimorphism,
  visuals: mob.data.visuals,
  audio: mob.data.audio,
}));
---

<RootLayout title="Archive | Ancient Nature">
  <main class="relative z-10 mx-auto w-full max-w-[1400px] px-4 sm:px-6 lg:px-12">
    <div class="w-full min-h-[calc(100svh-4rem)] pt-24 pb-8 sm:pt-28 lg:h-[calc(100vh-4rem)] lg:min-h-0 lg:pt-32 lg:pb-10">
      <ArchiveExplorer initialData={formattedData} client:load />
    </div>
  </main>
</RootLayout>
